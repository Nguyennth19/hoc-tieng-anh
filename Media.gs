function ensurePart2MediaAssets_(ss, p2Sheet, mediaSheet, report) {
  const seeds = getEmbeddedMediaSeed_();
  if (!seeds.length) return 0;

  let folder;
  try {
    folder = getOrCreateMediaFolder_(ss);
  } catch (err) {
    report.push('Media folder was not created: ' + err.message);
    return 0;
  }

  const mediaValues = mediaSheet.getDataRange().getValues();
  const mediaIdx = headerIndexMap_(mediaSheet);
  const existingByKey = {};
  mediaValues.slice(1).forEach(function(row) {
    const key = String(row[mediaIdx.assetKey] || '');
    if (key) existingByKey[key] = String(row[mediaIdx.driveFileId] || '');
  });

  const p2Values = p2Sheet.getDataRange().getValues();
  const p2Idx = headerIndexMap_(p2Sheet);
  const topicRow = {};
  p2Values.slice(1).forEach(function(row, i) {
    const id = String(row[p2Idx.id] || '');
    if (id) topicRow[id] = i + 2;
  });

  let created = 0;
  seeds.forEach(function(seed) {
    const assetKey = 'P2_IMG_' + seed.topicId;
    let fileId = existingByKey[assetKey];

    if (!fileId) {
      const blob = Utilities.newBlob(
        Utilities.base64Decode(seed.base64),
        seed.mimeType,
        seed.fileName
      );
      const file = folder.createFile(blob);
      fileId = file.getId();
      mediaSheet.appendRow([
        assetKey, 2, seed.topicId, fileId, seed.fileName,
        seed.mimeType, 'Speaking Part 2.docx · embedded source image', new Date()
      ]);
      existingByKey[assetKey] = fileId;
      created++;
    }

    const rowNum = topicRow[seed.topicId];
    if (rowNum && fileId) {
      const current = String(p2Sheet.getRange(rowNum, p2Idx.imageDriveId + 1).getDisplayValue() || '').trim();
      if (!current) p2Sheet.getRange(rowNum, p2Idx.imageDriveId + 1).setValue(fileId);
    }
  });

  setSetting_(ss.getSheetByName(SHEET_NAMES.SETTINGS), 'media_folder_id', folder.getId());
  return created;
}

function getOrCreateMediaFolder_(ss) {
  const props = PropertiesService.getScriptProperties();
  const savedId = String(props.getProperty('APTIS_MEDIA_FOLDER_ID') || '').trim();
  if (savedId) {
    try { return DriveApp.getFolderById(savedId); } catch (e) {}
  }

  let parent = null;
  try {
    const parents = DriveApp.getFileById(ss.getId()).getParents();
    if (parents.hasNext()) parent = parents.next();
  } catch (e) {}

  const container = parent || DriveApp.getRootFolder();
  const folders = container.getFoldersByName('APTIS_B2_APP_MEDIA');
  const folder = folders.hasNext() ? folders.next() : container.createFolder('APTIS_B2_APP_MEDIA');
  props.setProperty('APTIS_MEDIA_FOLDER_ID', folder.getId());
  return folder;
}

