function upgradeSpeakingPart3Description_(sheet, settings, report) {
  const current = getSetting_(settings, 'p3_description_version');
  if (current === PART3_DESCRIPTION_VERSION) return;

  PART3_DESCRIPTION_COLUMNS.forEach(function(header) {
    ensureColumn_(sheet, header, [], report);
  });

  const idx = headerIndexMap_(sheet);
  const values = sheet.getDataRange().getValues();
  const rowById = {};
  values.slice(1).forEach(function(row, i) {
    const id = String(row[idx.id] || '');
    if (id) rowById[id] = i + 2;
  });

  // Keep the original prototype topics for history, but remove them from active Part 3 practice.
  Object.keys(rowById).forEach(function(id) {
    if (/^SP3-\d{3}$/.test(id)) {
      sheet.getRange(rowById[id], idx.active + 1).setValue(false);
    }
  });

  getPart3DescriptionSeedData_().forEach(function(seed) {
    let rowNum = rowById[seed.id];
    if (!rowNum) {
      rowNum = sheet.getLastRow() + 1;
      sheet.getRange(rowNum, 1).setValue(seed.id);
      rowById[seed.id] = rowNum;
    }

    const set = function(name, value) {
      if (idx[name] !== undefined) sheet.getRange(rowNum, idx[name] + 1).setValue(value);
    };

    set('topic', seed.topic);
    set('examNo', seed.examNo);
    set('question1', seed.question1);
    set('question2', '');
    set('question3', '');
    set('model1', seed.model1);
    set('model2', '');
    set('model3', '');
    set('keywords1', seed.keywords1);
    set('keywords2', '');
    set('keywords3', '');
    set('structure1', seed.structure1);
    set('structure2', '');
    set('structure3', '');

    set('commonPoint', seed.commonPoint);
    set('comparisonAxis', seed.comparisonAxis);
    set('mustCommon', seed.mustCommon);
    set('mustPictureA', seed.mustPictureA);
    set('mustPictureB', seed.mustPictureB);
    set('mustDifference', seed.mustDifference);
    set('sayMore', seed.sayMore);
    set('descriptionModel', seed.model1);
    set('descriptionKeywords', seed.keywords1);
    set('descriptionTemplate', seed.structure1);
    set('practiceMode', 'description_only');
    set('contentVersion', PART3_DESCRIPTION_VERSION);
    set('active', true);
    set('sourceLabel', seed.sourceLabel);
  });

  setSetting_(settings, 'p3_description_version', PART3_DESCRIPTION_VERSION);
  report.push('Speaking Part 3 updated to 32 fact-first B2 compare-two-pictures topics (Q1 only).');
}

function getSpeakingPart3_() {
  const sheet = requireSheet_(SHEET_NAMES.SPEAKING_P3, HEADERS.SPEAKING_P3);
  const values = sheet.getDataRange().getValues();
  if (values.length < 2) return [];
  const idx = headerIndexMap_(sheet);

  return values.slice(1).filter(function(row) {
    return row[idx.id] && row[idx.active] !== false && String(row[idx.active]).toLowerCase() !== 'false';
  }).map(function(row) {
    const model = idx.descriptionModel !== undefined && row[idx.descriptionModel]
      ? String(row[idx.descriptionModel])
      : String(row[idx.model1] || '');
    const keywords = idx.descriptionKeywords !== undefined && row[idx.descriptionKeywords]
      ? String(row[idx.descriptionKeywords])
      : String(row[idx.keywords1] || '');
    const structure = idx.descriptionTemplate !== undefined && row[idx.descriptionTemplate]
      ? String(row[idx.descriptionTemplate])
      : String(row[idx.structure1] || '');

    return {
      id: String(row[idx.id] || ''),
      part: 3,
      examNo: idx.examNo !== undefined ? Number(row[idx.examNo] || 0) : 0,
      topic: String(row[idx.topic] || ''),
      imageA: {
        imageUrl: idx.imageAUrl !== undefined ? String(row[idx.imageAUrl] || '') : '',
        imageDriveId: idx.imageADriveId !== undefined ? String(row[idx.imageADriveId] || '') : '',
        imageAlt: idx.imageAAlt !== undefined ? String(row[idx.imageAAlt] || '') : 'First comparison picture',
        sceneIcon: '🖼️'
      },
      imageB: {
        imageUrl: idx.imageBUrl !== undefined ? String(row[idx.imageBUrl] || '') : '',
        imageDriveId: idx.imageBDriveId !== undefined ? String(row[idx.imageBDriveId] || '') : '',
        imageAlt: idx.imageBAlt !== undefined ? String(row[idx.imageBAlt] || '') : 'Second comparison picture',
        sceneIcon: '🖼️'
      },
      questions: [String(row[idx.question1] || 'Compare these two pictures.')],
      models: [model],
      keywords: [keywords],
      structures: [structure],
      commonPoint: idx.commonPoint !== undefined ? String(row[idx.commonPoint] || '') : '',
      comparisonAxis: idx.comparisonAxis !== undefined ? String(row[idx.comparisonAxis] || '') : '',
      mustCommon: idx.mustCommon !== undefined ? String(row[idx.mustCommon] || '') : '',
      mustPictureA: idx.mustPictureA !== undefined ? String(row[idx.mustPictureA] || '') : '',
      mustPictureB: idx.mustPictureB !== undefined ? String(row[idx.mustPictureB] || '') : '',
      mustDifference: idx.mustDifference !== undefined ? String(row[idx.mustDifference] || '') : '',
      sayMore: idx.sayMore !== undefined ? String(row[idx.sayMore] || '') : '',
      practiceMode: 'description_only',
      sourceLabel: String(row[idx.sourceLabel] || '')
    };
  });
}

function aggregatePart3DescriptionProgress_(taskId, promptProgress, topicRow) {
  const p = promptProgress[0] || defaultProgress_(taskId + '-1');
  return {
    questionId: taskId,
    status: p.status || 'new',
    rating: Number(p.rating || 0),
    reviewCount: Number(p.reviewCount || 0),
    lastReviewed: p.lastReviewed || '',
    nextReview: p.nextReview || '',
    note: '',
    favorite: topicRow ? Boolean(topicRow.favorite) : false,
    masteredPrompts: p.status === 'learned' ? 1 : 0,
    totalPrompts: 1
  };
}


function ensurePart3MediaAssets_(ss, p3Sheet, mediaSheet, report) {
  // Backward-compatible full preparation helper. Do not call this from blocking migration.
  const result = preparePart3MediaBatchInternal_(ss, p3Sheet, mediaSheet, 0, 9999);
  return result.created;
}

/**
 * Client-callable background media preparation for Part 3.
 * Creates only a small batch per Apps Script execution so bootstrap never waits for 64 Drive files.
 */
function preparePart3MediaBatch(startIndex, batchSize) {
  const ss = getDatabase_();
  const p3Sheet = requireSheet_(SHEET_NAMES.SPEAKING_P3, HEADERS.SPEAKING_P3);
  const mediaSheet = requireSheet_(SHEET_NAMES.MEDIA, HEADERS.MEDIA);
  const start = Math.max(0, Number(startIndex || 0));
  const size = Math.min(16, Math.max(2, Number(batchSize || 8)));
  const result = preparePart3MediaBatchInternal_(ss, p3Sheet, mediaSheet, start, size);
  clearSpeakingContentCache_();
  return result;
}

function preparePart3MediaBatchInternal_(ss, p3Sheet, mediaSheet, startIndex, batchSize) {
  const seeds = getPart3ExamMediaSeed_();
  const total = seeds.length;
  const start = Math.max(0, Number(startIndex || 0));
  const end = Math.min(total, start + Math.max(1, Number(batchSize || 8)));
  if (!total || start >= total) {
    return { ok: true, created: 0, processed: 0, nextIndex: total, total: total, done: true };
  }

  let folder;
  try {
    folder = getOrCreateMediaFolder_(ss);
  } catch (err) {
    return { ok: false, created: 0, processed: 0, nextIndex: start, total: total, done: false, error: err.message };
  }

  const mediaValues = mediaSheet.getDataRange().getValues();
  const mediaIdx = headerIndexMap_(mediaSheet);
  const existingByKey = {};
  mediaValues.slice(1).forEach(function(row) {
    const key = String(row[mediaIdx.assetKey] || '');
    if (key) existingByKey[key] = String(row[mediaIdx.driveFileId] || '');
  });

  const p3Values = p3Sheet.getDataRange().getValues();
  const p3Idx = headerIndexMap_(p3Sheet);
  const topicRow = {};
  p3Values.slice(1).forEach(function(row, i) {
    const id = String(row[p3Idx.id] || '');
    if (id) topicRow[id] = i + 2;
  });

  let created = 0;
  for (let i = start; i < end; i++) {
    const seed = seeds[i];
    const assetKey = 'P3_IMG_' + seed.topicId + '_' + seed.side;
    let fileId = existingByKey[assetKey];

    if (!fileId) {
      const blob = Utilities.newBlob(
        Utilities.base64Decode(seed.base64),
        seed.mimeType,
        seed.fileName
      );
      const file = folder.createFile(blob);
      fileId = file.getId();
      mediaSheet.appendRow([
        assetKey, 3, seed.topicId, fileId, seed.fileName,
        seed.mimeType, 'de thi part 03.pdf · comparison image', new Date()
      ]);
      existingByKey[assetKey] = fileId;
      created++;
    }

    const rowNum = topicRow[seed.topicId];
    if (rowNum && fileId) {
      const idHeader = seed.side === 'A' ? 'imageADriveId' : 'imageBDriveId';
      const altHeader = seed.side === 'A' ? 'imageAAlt' : 'imageBAlt';
      if (p3Idx[idHeader] !== undefined) {
        const cell = p3Sheet.getRange(rowNum, p3Idx[idHeader] + 1);
        if (!String(cell.getDisplayValue() || '').trim()) cell.setValue(fileId);
      }
      if (p3Idx[altHeader] !== undefined) {
        const altCell = p3Sheet.getRange(rowNum, p3Idx[altHeader] + 1);
        if (!String(altCell.getDisplayValue() || '').trim()) altCell.setValue(seed.imageAlt || '');
      }
    }
  }

  setSetting_(ss.getSheetByName(SHEET_NAMES.SETTINGS), 'media_folder_id', folder.getId());
  return {
    ok: true,
    created: created,
    processed: end - start,
    nextIndex: end,
    total: total,
    done: end >= total
  };
}

